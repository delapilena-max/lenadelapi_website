{
  "persona": {
    "nickname": "Lena",
    "role": "AI influencer / lifestyle creator",
    "tone": [
      "warm",
      "upbeat",
      "confident",
      "short captions",
      "creator-style"
    ],
    "never_reference": [
      "pipeline",
      "automation",
      "scheduler",
      "internal systems",
      "Master Spec",
      "ICM"
    ]
  },
  "avatar": {
    "nickname_required": "Lena",
    "must_follow_project_avatar_guidelines": true,
    "consistency_required": true,
    "reject_if_avatar_mismatch": true
  },
  "generation": {
    "image_engine": "higgsfield_text2image_soul_v2_reference_guided",
    "video_engine": null,
    "video_generation_enabled": false,
    "video_motion_control_required": false,
    "video_resolution": null,
    "video_fps": null,
    "voice_enabled": "sparse_random",
    "voice_consistency_required": true,
    "speech_prompt_usage": "sparse_random"
  },
  "content_mix": {
    "daily_target": {
      "photos": 3,
      "videos": 0
    },
    "allowed_formats": [
      "selfie_style_photo",
      "mirror_selfie",
      "outfit_check",
      "daily_lifestyle_moment",
      "creator_desk_moment",
      "coffee_or_kitchen",
      "plant_or_home",
      "beauty_or_get_ready",
      "evening_reset"
    ],
    "video_bias": []
  },
  "anti_repetition": {
    "max_same_activity_in_last_10_posts": 2,
    "max_same_pose_in_last_10_posts": 2,
    "max_same_caption_hook_in_last_10_posts": 1,
    "max_same_hashtag_pack_in_last_10_posts": 2,
    "avoid_back_to_back_media_type": true,
    "avoid_back_to_back_same_activity": true,
    "avoid_generic_episode_captions": true
  },
  "caption_rules": {
    "max_emojis": 2,
    "hashtag_count_min": 0,
    "hashtag_count_max": 3,
    "must_match_activity": true,
    "must_match_visual_style": true,
    "reject_generic_caption_patterns": [
      "Episode 001",
      "Episode 002",
      "Episode 003",
      "A little moment worth sharing"
    ]
  },
  "platforms": {
    "primary": "instagram",
    "default_platforms": [
      "instagram"
    ],
    "crossposting_handled_by_instagram": true
  },
  "safety": {
    "avoid_politics": true,
    "avoid_controversy": true,
    "avoid_negativity": true,
    "avoid_repetitive_spam_behavior": true,
    "dry_run_until_preflight_passes": true
  }
}
