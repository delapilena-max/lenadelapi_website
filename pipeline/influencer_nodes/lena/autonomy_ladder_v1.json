        "separate_posting_approval_required": true,
        "per_slot_approval_required": true
      },
      "failure_handling": [
        "retain immutable claim and receipt evidence",
        "stop after one bounded retry path",
        "require manual reconciliation before any new approval is used"
      ],
      "tests_required": [
        "Higgsfield approval tests",
        "Higgsfield claim and receipt tests",
        "QA disposition tests",
        "bounded retry tests"
