    "semantic_evaluator": {"type": "object", "additionalProperties": false, "required": ["required", "visual_continuity", "narrator_quality", "bureau_identity", "overall_quality", "notes"], "properties": {"required": {"const": true}, "visual_continuity": {"enum": ["not_evaluated", "pass", "fail"]}, "narrator_quality": {"enum": ["not_evaluated", "pass", "fail"]}, "bureau_identity": {"enum": ["not_evaluated", "pass", "fail"]}, "overall_quality": {"enum": ["not_evaluated", "pass", "fail"]}, "notes": {"type": "array", "items": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}, "maxItems": 100}}},
    "optional_human_review": {"type": "object", "additionalProperties": false, "required": ["required", "status", "notes"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["not_requested", "pending", "approved", "rejected"]}, "notes": {"type": "array", "items": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}, "maxItems": 100}}}, "disposition": {"enum": ["planned", "approve", "reject", "revise"]}
