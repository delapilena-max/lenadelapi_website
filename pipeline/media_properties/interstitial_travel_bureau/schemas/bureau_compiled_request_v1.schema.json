{
  "$id": "bureau_compiled_request_v1.schema.json", "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_id", "property_id", "episode_id", "created_at", "generator_version", "upstream_artifacts", "compiler_version", "source_json_references", "provider", "model", "shot_requests", "compilation_timestamp", "deterministic_compilation_fingerprint", "execution_authorized"],
  "properties": {
    "schema_version": {"$ref": "common_defs_v1.schema.json#/$defs/schema_version"}, "artifact_type": {"const": "bureau_compiled_request_v1"}, "artifact_id": {"$ref": "common_defs_v1.schema.json#/$defs/artifact_id"}, "property_id": {"$ref": "common_defs_v1.schema.json#/$defs/property_id"}, "episode_id": {"$ref": "common_defs_v1.schema.json#/$defs/episode_id"}, "created_at": {"$ref": "common_defs_v1.schema.json#/$defs/created_at"}, "generator_version": {"$ref": "common_defs_v1.schema.json#/$defs/generator_version"}, "upstream_artifacts": {"$ref": "common_defs_v1.schema.json#/$defs/upstream_artifacts"},
    "compiler_version": {"const": "itb_deterministic_compiler_v1"}, "source_json_references": {"type": "array", "items": {"$ref": "common_defs_v1.schema.json#/$defs/upstream_artifact"}, "minItems": 1, "maxItems": 30, "uniqueItems": true}, "provider": {"const": "unassigned_provider_interface"}, "model": {"const": "unassigned_model"}, "compilation_timestamp": {"$ref": "common_defs_v1.schema.json#/$defs/created_at"}, "deterministic_compilation_fingerprint": {"$ref": "common_defs_v1.schema.json#/$defs/sha256"}, "execution_authorized": {"const": false},
    "shot_requests": {"type": "array", "minItems": 7, "maxItems": 11, "items": {"type": "object", "additionalProperties": false, "required": ["shot_id", "exact_compiled_prompt", "exact_negative_prompt", "request_payload", "dimensions", "duration_ms", "cost_ceiling_cents", "attempt_ceiling", "output_location"], "properties": {"shot_id": {"type": "string", "pattern": "^shot_[0-9]{2}$"}, "exact_compiled_prompt": {"type": "string", "minLength": 80, "maxLength": 12000}, "exact_negative_prompt": {"type": "string", "minLength": 10, "maxLength": 4000}, "request_payload": {"type": "object", "additionalProperties": false, "required": ["interface_version", "operation", "prompt", "negative_prompt", "aspect_ratio", "duration_ms"], "properties": {"interface_version": {"const": "itb_compiled_request_interface_v1"}, "operation": {"enum": ["generate_still", "generate_motion", "render_graphic", "generate_hybrid"]}, "prompt": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}, "negative_prompt": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}, "aspect_ratio": {"enum": ["9:16", "1:1", "4:5", "16:9"]}, "duration_ms": {"type": "integer", "minimum": 2000, "maximum": 10000}}}, "dimensions": {"type": "object", "additionalProperties": false, "required": ["aspect_ratio", "orientation"], "properties": {"aspect_ratio": {"enum": ["9:16", "1:1", "4:5", "16:9"]}, "orientation": {"enum": ["portrait", "square", "landscape"]}}}, "duration_ms": {"type": "integer", "minimum": 2000, "maximum": 10000}, "cost_ceiling_cents": {"type": "integer", "minimum": 0, "maximum": 100000}, "attempt_ceiling": {"type": "integer", "minimum": 1, "maximum": 5}, "output_location": {"type": "string", "pattern": "^outputs/", "maxLength": 300}}}}
  }
}
