{
  "$id": "common_defs_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact_id": {"type": "string", "pattern": "^[a-z0-9_]{8,160}$"},
    "video_id": {"type": "string", "pattern": "^lena_video_[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9_]+$"},
    "governed_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nonempty_string": {"type": "string", "minLength": 1, "maxLength": 4000},
    "provider_prompt_cue": {"type": "string", "minLength": 20, "maxLength": 600},
    "slug": {"type": "string", "pattern": "^[a-z0-9_]{2,120}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "string_list": {"type": "array", "items": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}, "minItems": 1, "maxItems": 80, "uniqueItems": true},
    "optional_string_list": {"type": "array", "items": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}, "maxItems": 80, "uniqueItems": true},
    "upstream_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "common_defs_v1.schema.json#/$defs/artifact_id"},
        "sha256": {"$ref": "common_defs_v1.schema.json#/$defs/sha256"}
      }
    },
    "upstream_artifacts": {"type": "array", "items": {"$ref": "common_defs_v1.schema.json#/$defs/upstream_artifact"}, "maxItems": 30, "uniqueItems": true},
    "attempt_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_attempts", "retry_authorized", "separate_authorization_required", "credit_ceiling_applies_to_all_attempts"],
      "properties": {
        "authorized_attempts": {"type": "integer", "minimum": 0, "maximum": 10},
        "retry_authorized": {"type": "boolean"},
        "separate_authorization_required": {"const": true},
        "credit_ceiling_applies_to_all_attempts": {"const": true}
      }
    },
    "user_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "value"],
      "properties": {
        "field_path": {"type": "string", "pattern": "^/lena_[a-z0-9_]+_v1/", "maxLength": 300},
        "value": {"type": ["string", "integer", "boolean"]}
      }
    },
    "timeline_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "action", "body_movement", "meaningful_displacement_cm", "gaze_target", "expression", "blink_count", "breathing", "weight_transfer", "gesture_initiation", "gesture_completion", "recovery", "camera_relationship", "provider_prompt_cue"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0, "maximum": 7999},
        "end_ms": {"type": "integer", "minimum": 1, "maximum": 8000},
        "action": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "body_movement": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "meaningful_displacement_cm": {"type": "integer", "minimum": 0, "maximum": 200},
        "gaze_target": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "expression": {"$ref": "common_defs_v1.schema.json#/$defs/slug"},
        "blink_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "breathing": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "weight_transfer": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "gesture_initiation": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "gesture_completion": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "recovery": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "camera_relationship": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "provider_prompt_cue": {"$ref": "common_defs_v1.schema.json#/$defs/provider_prompt_cue"}
      }
    },
    "garment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["garment", "fit", "material", "color", "fastened_state", "continuity", "movement_behavior"],
      "properties": {
        "garment": {"$ref": "common_defs_v1.schema.json#/$defs/slug"},
        "fit": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "material": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "color": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"},
        "fastened_state": {"enum": ["fully_fastened", "secured", "unfastened"]},
        "continuity": {"enum": ["entire_video", "partial_video"]},
        "movement_behavior": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}
      }
    },
    "qa_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "evidence"],
      "properties": {
        "check_id": {"$ref": "common_defs_v1.schema.json#/$defs/slug"},
        "status": {"enum": ["passed", "failed", "not_assessable", "not_applicable"]},
        "evidence": {"$ref": "common_defs_v1.schema.json#/$defs/nonempty_string"}
      }
    }
  }
}
