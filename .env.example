# Canonical shared Lena publisher and provider secrets.
# Do not create a .env in this deployment checkout.
# Populate only:
# C:\projects\ai\content_bot\.env
# Non-secret IDs and the public media base URL live in tracked configuration.

META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Lena governed ElevenLabs voice lane.
# Keep both values machine-local. Never commit the API key or actual voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_LENA_VOICE_ID=
